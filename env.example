# ШАБЛОН. Реальные значения только в Render -> Environment, не в GitHub.
# Обязательные
BOT_TOKEN=            # токен из @BotFather
ADMIN_ID=             # твой числовой Telegram ID (@userinfobot)
ENC_KEY=              # python app.py genkey; копию храни отдельно
# Рекомендуется
BACKUP_BOT_TOKEN=     # второй бот для бэкапов (нажми в нём /start)
OPENROUTER_KEYS=      # через запятую; пул только для админа и рассылки
TESTER_ID=            # ID через запятую
RECOVERY_PUB=         # открытая половина (python app.py genrecovery); закрытую в Render НЕ класть
# Необязательно
