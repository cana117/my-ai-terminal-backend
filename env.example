# Это ШАБЛОН. Реальные значения вписывай ТОЛЬКО в Render -> Environment. В GitHub их не клади.

# --- Обязательные ---
# Бот для общения (токен из @BotFather)
BOT_TOKEN=
# Твой числовой Telegram ID (например, из бота @userinfobot)
ADMIN_ID=
# Мастер-ключ шифрования ключей людей и бэкапов. Создай на своём компьютере: python app.py genkey
# Копию храни отдельно от Render. Потеряешь, зашифрованное не вернуть.
ENC_KEY=

# --- Рекомендуется ---
# Бот для бэкапов (второй бот из @BotFather). Открой его и нажми /start.
BACKUP_BOT_TOKEN=
# BACKUP_CHAT_ID=   (необязательно, по умолчанию твой ADMIN_ID)
# Ключи OpenRouter через запятую. Общий пул: только админу и системным задачам.
OPENROUTER_KEYS=
POLLINATIONS_KEY=
# Защита админ-адресов сайта (любая длинная случайная строка, подойдёт python app.py genkey)
ADMIN_TOKEN=

# --- Аварийный ключ (по желанию, можно добавить позже) ---
# Сюда только ОТКРЫТАЯ половина пары (python app.py genrecovery).
# Закрытую половину в Render НЕ класть: она хранится только у тебя.
RECOVERY_PUB=

# --- Необязательно ---
# Тестеры (второй аккаунт, друг): ID через запятую, не админы, без доступа к админ-данным. Можно и командой /admin tester add ID
# TESTER_ID=
# Старый мастер-ключ, только на время смены ENC_KEY (потом /admin rotate и удалить)
# ENC_KEY_OLD=
# 0 = не шифровать бэкапы
# BACKUP_ENC=1
# BACKUP_MAX_MB=45
# 1 = дать общий пул ключей и обычным пользователям (по умолчанию выключено)
# POOL_FOR_USERS=0
# Нужен, только если сайт лежит на другом домене, чем сервис: WEB_ORIGIN=https://твой-сайт.example
# WEB_ORIGIN=
# DB_PATH=/tmp/data.db
# Антиспам: сообщений за окно, длина окна (сек), тишина (сек)
# FLOOD_N=5
# FLOOD_SEC=8
# FLOOD_MUTE=30
# NEWS_RSS=https://lenta.ru/rss/news
# YT_CHANNELS=
# TWITCH_ID=
# TWITCH_SECRET=
# TWITCH_USERS=
# MC_DATA_VERSION=4671
# Файлы и картинки (пункт 5)
# Файлы: по умолчанию не больше 20 МБ (предел облачного Telegram). Больше только со своим Bot API-сервером (TG_API), тогда до 100
# FILE_MAX_MB=20
# Рассылка новостей: сколько человек за раз (по умолчанию 20, максимум 30)
# NEWS_BATCH=20
# Частей на большой файл
# FILE_PARTS=6
# FILE_CHARS=12000
# IMG_COOLDOWN=60
# Свой Bot API-сервер Telegram (только если нужны файлы больше 20 МБ; обычно не нужно)
# TG_API=
# Примечание: RECOVERY_KEY (закрытый аварийный ключ) в Render НЕ класть, он нужен только на твоём компьютере для команды recover.
# Примечание: RENDER_EXTERNAL_URL Render задаёт сам, вписывать не нужно.
