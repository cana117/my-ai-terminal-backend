# Скопируй имена в Render -> Environment. Значения НИКОГДА не кладём в GitHub.

# --- обязательные ---
BOT_TOKEN=             # токен основного бота от @BotFather
ADMIN_ID=              # твой числовой Telegram ID
ENC_KEY=               # мастер-ключ шифрования; сгенерируй командой /admin_genkey (или python -c "import secrets;print(secrets.token_urlsafe(48))")

# --- желательные ---
RENDER_EXTERNAL_URL=   # https://твой-сервис.onrender.com (нужен для кнопки терминала и самопинга)
ADMIN_TOKEN=           # длинный пароль для входа в терминал с сайта (не в Telegram)
BACKUP_BOT_TOKEN=      # второй бот только для бэкапов (в нём нажми /start)
BACKUP_CHAT_ID=        # куда слать бэкапы (по умолчанию ADMIN_ID)
WEB_ORIGIN=            # адрес страницы, если она лежит на другом домене (для CORS)

# --- люди ---
TESTER_ID=             # ID через запятую: стартовые тестеры (tester1), для второго аккаунта и друга
PROTECTED_IDS=         # ID через запятую: защищённые (автоматика их не банит, снимать и банить только ты)

# --- при смене ENC_KEY ---
ENC_KEY_OLD=           # старый ENC_KEY: бот сам перешифрует ключи людей, потом удали эту переменную

# --- по желанию ---
POLLINATIONS_KEY=      # ключ для картинок и запасного ИИ (необязательно)
TWITCH_ID=             # для будущей функции Twitch (сейчас заглушка)
TWITCH_SECRET=
FLOOD_N=5              # сообщений ...
FLOOD_SEC=10           # ... за столько секунд = флуд
STARS_AUTO=0           # 1 = пробовать stub_send_stars при подтверждении награды (пока заглушка)
SSRF_PIN=1             # 0 = выключить привязку к IP при загрузке новостей (если новости перестали грузиться)
AUTO_INSTALL=0         # 1 = ВРЕМЕННО: бот сам поставит cryptography при старте, если её нет (правильно: Build Command = pip install -r requirements.txt)
DB_PATH=/tmp/data.db
